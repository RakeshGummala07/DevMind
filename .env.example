# ── MySQL ──────────────────────────────────────────────
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=devmind
MYSQL_USERNAME=devmind
MYSQL_PASSWORD=devmind_local_password
MYSQL_ROOT_PASSWORD=devmind_root_password

# ── MongoDB ────────────────────────────────────────────
MONGODB_URI=mongodb://devmind:devmind_local_password@mongodb:27017/devmind?authSource=admin
MONGO_INITDB_ROOT_USERNAME=devmind
MONGO_INITDB_ROOT_PASSWORD=devmind_local_password

# ── Redis ──────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Kafka ──────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ── Qdrant ─────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333

# ── AI / Ollama ────────────────────────────────────────
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
AI_MODEL=llama3.1:8b
EMBEDDING_MODEL=nomic-embed-text

# ── GitHub OAuth / Webhooks ────────────────────────────
GITHUB_CLIENT_ID=replace_me
GITHUB_CLIENT_SECRET=replace_me
GITHUB_WEBHOOK_SECRET=replace_me
GITHUB_REDIRECT_URI=http://localhost:5173/oauth/callback

# ── Auth ───────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_string_min_256_bits
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=7
INTERNAL_API_KEY=replace_with_a_shared_internal_secret
AUTH_SERVICE_URL=http://auth-service:8081

# ── MinIO (S3-compatible object storage) ───────────────
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=devmind
MINIO_SECRET_KEY=devmind_local_password
MINIO_BUCKET=devmind-artifacts

# ── Observability ──────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OPENSEARCH_URL=http://opensearch:9200

# ── Gateway ─────────────────────────────────────────────
GATEWAY_PORT=9000
FRONTEND_ORIGIN=http://localhost:5173
